@page "/tasks/edit"
@model LiteJob.Web.Pages.TasksEditModel
@{
    ViewData["Title"] = "任务编辑 - LiteJob";
    Layout = "_Layout";
}

<h2 class="page-title" id="page-title">新建任务</h2>

<div id="global-error"></div>
<div id="form-error" style="display:none; margin-bottom: 12px; padding: 8px 12px; background: #fdecea; color: #c0392b; border: 1px solid #f5b7b1; border-radius: 4px;"></div>

<form id="task-form" onsubmit="return save(event);">
    <div class="panel">
        <div class="section-title" style="margin-top: 0;">基本信息</div>
        <div class="form-item">
            <label>任务名称 *</label>
            <input id="f-name" type="text" required placeholder="全局唯一" />
        </div>
        <div class="form-item">
            <label>分组</label>
            <input id="f-group" type="text" placeholder="default" />
        </div>
        <div class="form-item">
            <label>备注</label>
            <input id="f-remark" type="text" placeholder="选填" />
        </div>
    </div>

    <div class="panel">
        <div class="section-title" style="margin-top: 0;">触发模式</div>
        <div class="form-item">
            <label style="display:inline-block; margin-right: 24px;">
                <input type="radio" name="trigger-mode" value="cron" checked onchange="onModeChange()" /> cron 循环调度
            </label>
            <label style="display:inline-block;">
                <input type="radio" name="trigger-mode" value="once" onchange="onModeChange()" /> once 一次性
            </label>
        </div>
        <div id="cron-section">
            <div class="form-item">
                <label>cron 表达式（5 或 6 字段，6 字段含秒，服务器本地时区）</label>
                <div style="display:flex; gap:10px; align-items:center; max-width: 640px;">
                    <input id="f-cron" type="text" style="flex:1;" placeholder="*/5 * * * * ?" oninput="onCronInput()" />
                    <select id="cron-template" onchange="applyTemplate(this.value)">
                        <option value="">常用模板…</option>
                        <option value="0/5 * * * * ?">每5秒</option>
                        <option value="0 * * * * ?">每分钟</option>
                        <option value="0 0 8 * * ?">每天8点</option>
                        <option value="0 0 * * * ?">每小时</option>
                        <option value="0 0 9 ? * 2">每周一9点</option>
                    </select>
                </div>
                <div id="cron-preview" class="muted" style="margin-top: 8px; font-size: 13px; line-height: 1.8;">输入表达式后实时预览未来 5 次触发</div>
            </div>
        </div>
        <div id="once-section" style="display:none;">
            <div class="form-item">
                <label>触发时间（到点执行一次后自动结束）</label>
                <input id="f-once" type="datetime-local" onchange="onOnceInput()" />
                <div class="muted" style="margin-top: 6px; font-size: 13px;">保存后 cron 字段将写入 once:yyyy-MM-dd HH:mm</div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="section-title" style="margin-top: 0;">执行器参数</div>
        <div class="form-item">
            <label>执行器类型</label>
            <select id="f-type" onchange="onTypeChange()">
                <option value="http">http（HTTP API 调用）</option>
                <option value="mail">mail（M4 交付）</option>
            </select>
        </div>
        <div id="http-params">
            <div class="form-item">
                <label>method</label>
                <select id="p-method">
                    <option>GET</option><option>POST</option><option>PUT</option><option>DELETE</option>
                </select>
            </div>
            <div class="form-item">
                <label>url *</label>
                <input id="p-url" type="text" placeholder="http://..." />
            </div>
            <div class="form-item">
                <label>headers（支持 {date} 等模板变量与 $cred:名称.key 凭证引用）</label>
                <div id="header-rows"></div>
                <button type="button" class="btn mini" onclick="addHeaderRow('', '')">＋ 添加 Header</button>
            </div>
            <div class="form-item">
                <label>body（POST/PUT 可用）</label>
                <textarea id="p-body" rows="4" placeholder='{"key": "{date}"}'></textarea>
            </div>
            <div class="form-item">
                <label>successContains（可选：响应体包含此串才算成功，留空则 2xx 即成功）</label>
                <input id="p-success" type="text" />
            </div>
            <div class="form-item">
                <label>auth 块（可选：声明式登录换 token，JSON 对象）</label>
                <textarea id="p-auth" rows="3" placeholder='{"type":"login","loginUrl":"http://wms/login","loginBody":{"u":"$cred:wms.user"},"tokenPath":"$.data.accessToken","injectAs":"Authorization: Bearer {token}"}'></textarea>
                <div class="muted" style="font-size:12px; margin-top:4px;">留空不启用。loginBody 的值支持 $cred 引用。</div>
            </div>
        </div>
        <div id="mail-params">
            <div style="display:flex; gap: 24px; flex-wrap: wrap;">
                <div class="form-item" style="flex:2; min-width: 240px;">
                    <label>收件人 to *（多个用逗号分隔）</label>
                    <input id="m-to" type="text" placeholder="a@example.com, b@example.com" />
                </div>
                <div class="form-item" style="flex:2; min-width: 240px;">
                    <label>抄送 cc（选填，逗号分隔）</label>
                    <input id="m-cc" type="text" />
                </div>
            </div>
            <div class="form-item">
                <label>主题（支持 {date} 等模板变量）</label>
                <input id="m-subject" type="text" placeholder="WMS 库存日报 {date}" />
            </div>
            <div class="form-item">
                <label>
                    <input id="m-html" type="checkbox" /> 正文为 HTML
                </label>
            </div>
            <div class="form-item">
                <label>正文</label>
                <textarea id="m-body" rows="5" placeholder="详见附件"></textarea>
            </div>
            <div class="form-item">
                <label>附件（缺失时：勾选 optional 则跳过该附件，否则任务失败）</label>
                <div id="attach-rows"></div>
                <button type="button" class="btn mini" onclick="addAttachRow()">＋ 添加附件</button>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="section-title" style="margin-top: 0;">执行质量</div>
        <div style="display:flex; gap: 24px; flex-wrap: wrap;">
            <div class="form-item" style="flex:1; max-width: 220px;">
                <label>超时（秒）</label>
                <input id="f-timeout" type="number" min="1" max="3600" value="30" />
            </div>
            <div class="form-item" style="flex:1; max-width: 220px;">
                <label>重试次数（不含首次）</label>
                <input id="f-retry" type="number" min="0" max="10" value="3" />
            </div>
            <div class="form-item" style="flex:1; max-width: 220px;">
                <label>启用状态</label>
                <select id="f-enabled"><option value="1">启用</option><option value="0">停用</option></select>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="section-title" style="margin-top: 0;">通知策略（最终失败时告警）</div>
        <div class="form-item">
            <label style="display:inline-block; margin-right: 20px;">
                <input type="radio" name="notify-on" value="final_failure" checked onchange="onNotifyOnChange()" /> 每次最终失败
            </label>
            <label style="display:inline-block; margin-right: 20px;">
                <input type="radio" name="notify-on" value="consecutive" onchange="onNotifyOnChange()" /> 连续失败达到
            </label>
            <input id="notify-count" type="number" min="1" max="100" value="2" style="width: 70px; padding: 6px 8px; border: 1px solid #dcdde1; border-radius: 4px;" onchange="onNotifyOnChange()" /> 次
            <label style="display:inline-block; margin-left: 20px;">
                <input type="radio" name="notify-on" value="never" onchange="onNotifyOnChange()" /> 从不通知
            </label>
        </div>
        <div class="form-item">
            <label>告警通道（多选；不选则用系统设置的默认通道，仍无则发全部启用通道）</label>
            <div id="notify-channel-box" style="display:flex; gap: 14px; flex-wrap: wrap; padding: 8px 0;">
                <span class="muted">加载中…</span>
            </div>
        </div>
    </div>

    <div style="display:flex; gap: 12px; margin-bottom: 24px;">
        <button type="submit" class="btn primary" id="save-btn" style="padding: 8px 28px;">保 存</button>
        <a class="btn" href="/tasks">取消</a>
    </div>
</form>

@section Scripts {
<script>
    var taskId = @(Model.TaskId?.ToString() ?? "null");
    var debounceTimer = null;

    function escapeHtml(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function showFormError(msg) {
        var box = document.getElementById('form-error');
        box.textContent = msg;
        box.style.display = 'block';
        window.scrollTo(0, 0);
    }
    function hideFormError() { document.getElementById('form-error').style.display = 'none'; }

    function currentMode() {
        return document.querySelector('input[name="trigger-mode"]:checked').value;
    }

    function onModeChange() {
        var cron = currentMode() === 'cron';
        document.getElementById('cron-section').style.display = cron ? '' : 'none';
        document.getElementById('once-section').style.display = cron ? 'none' : '';
    }

    function onCronInput() {
        document.getElementById('cron-template').value = '';
        schedulePreview();
    }

    function applyTemplate(expr) {
        if (!expr) return;
        document.getElementById('f-cron').value = expr;
        schedulePreview();
    }

    function schedulePreview() {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(previewCron, 400);
    }

    async function previewCron() {
        if (currentMode() !== 'cron') return;
        var expr = document.getElementById('f-cron').value.trim();
        var box = document.getElementById('cron-preview');
        if (!expr) { box.textContent = '输入表达式后实时预览未来 5 次触发'; box.className = 'muted'; return; }
        try {
            var resp = await fetchApi('/api/cron/preview', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ expr: expr })
            });
            var d = await resp.json();
            if (d.ok) {
                box.innerHTML = '未来 5 次触发：<br/>' + d.times.map(function (t) { return fmtTime(t); }).join('<br/>');
                box.className = '';
                box.style.color = '#1e8e5a';
            } else {
                box.textContent = '✗ ' + (d.error || '表达式非法');
                box.style.color = '#c0392b';
            }
        } catch (err) { box.textContent = '预览请求失败'; box.style.color = '#c0392b'; }
    }

    function onOnceInput() { }

    function onTypeChange() {
        var type = document.getElementById('f-type').value;
        document.getElementById('http-params').style.display = type === 'http' ? '' : 'none';
        document.getElementById('mail-params').style.display = type === 'mail' ? '' : 'none';
        document.getElementById('save-btn').disabled = false;
    }

    var credentialNames = [];
    var notifyChannels = [];

    async function loadCredentialOptions() {
        try {
            var resp = await fetchApi('/api/credentials');
            if (!resp.ok) return;
            var data = await resp.json();
            credentialNames = data.items.map(function (c) { return c.name; });
        } catch (err) { }
    }

    async function loadNotifyChannelOptions(selectedIds) {
        try {
            var resp = await fetchApi('/api/channels');
            if (!resp.ok) return;
            var data = await resp.json();
            notifyChannels = data.items.filter(function (c) { return c.enabled === 1; });
            var box = document.getElementById('notify-channel-box');
            if (notifyChannels.length === 0) {
                box.innerHTML = '<span class="muted">暂无启用的告警通道（可在"告警通道"页创建）</span>';
                return;
            }
            box.innerHTML = notifyChannels.map(function (c) {
                var checked = (selectedIds || []).indexOf(c.id) >= 0 ? ' checked' : '';
                return '<label style="white-space:nowrap;"><input type="checkbox" class="notify-ch" value="' + c.id + '"' + checked + ' /> ' +
                    escapeHtml(c.name) + '（' + escapeHtml(c.type) + '）</label>';
            }).join('');
        } catch (err) { }
    }

    function currentNotifyOn() {
        return document.querySelector('input[name="notify-on"]:checked').value;
    }

    function onNotifyOnChange() {
        var on = currentNotifyOn();
        document.getElementById('notify-count').style.display = on === 'consecutive' ? '' : 'none';
    }

    function buildNotifyPolicy() {
        var on = currentNotifyOn();
        var policy = { notifyOn: on, channels: [] };
        if (on === 'consecutive') {
            policy.count = parseInt(document.getElementById('notify-count').value) || 2;
        }
        document.querySelectorAll('#notify-channel-box .notify-ch:checked').forEach(function (cb) {
            policy.channels.push(parseInt(cb.value));
        });
        return JSON.stringify(policy);
    }

    function fillNotifyPolicy(policyJson) {
        var notifyOn = 'final_failure', count = 2, channelIds = [];
        try {
            var p = JSON.parse(policyJson || '{}') || {};
            if (p.notifyOn) notifyOn = p.notifyOn;
            if (p.count) count = p.count;
            if (Array.isArray(p.channels)) channelIds = p.channels;
        } catch (e) { }
        var radio = document.querySelector('input[name="notify-on"][value="' + notifyOn + '"]')
            || document.querySelector('input[name="notify-on"][value="final_failure"]');
        radio.checked = true;
        document.getElementById('notify-count').value = count;
        onNotifyOnChange();
        loadNotifyChannelOptions(channelIds);
    }

    function attachRowHtml(att) {
        att = att || {};
        var typeOptions = '<option value="file"' + (att.type === 'file' ? ' selected' : '') + '>file</option>' +
            '<option value="http"' + (att.type === 'http' ? ' selected' : '') + '>http</option>';
        var credOptions = '<option value="">credentialId（选填）</option>' + credentialNames.map(function (n) {
            return '<option value="' + escapeHtml(n) + '"' + (att.credentialId === n ? ' selected' : '') + '>' + escapeHtml(n) + '</option>';
        }).join('');
        var pathLabel = att.type === 'http' ? 'URL' : '文件路径';
        return '<div class="attach-row" style="display:flex; gap:6px; margin-bottom:6px; align-items:center; flex-wrap:wrap;">' +
            '<select class="a-type" onchange="onAttachTypeChange(this)">' + typeOptions + '</select>' +
            '<input class="a-path" type="text" placeholder="' + pathLabel + '（支持 {date} 变量）" style="flex:2; min-width: 200px; padding:7px 9px; border:1px solid #dcdde1; border-radius:4px;" value="' + escapeHtml(att.path || att.url || '') + '" />' +
            '<label style="white-space:nowrap; font-size:12px;"><input class="a-optional" type="checkbox"' + (att.optional ? ' checked' : '') + ' /> optional</label>' +
            '<select class="a-cred" style="max-width: 150px;">' + credOptions + '</select>' +
            '<button type="button" class="btn mini danger" onclick="this.parentNode.remove()">删</button>' +
            '</div>';
    }

    function onAttachTypeChange(select) {
        var row = select.parentNode;
        var isHttp = select.value === 'http';
        var path = row.querySelector('.a-path');
        path.placeholder = isHttp ? 'URL（支持 {date} 变量）' : '文件路径（支持 {date} 变量）';
    }

    function addAttachRow(att) {
        var container = document.getElementById('attach-rows');
        container.insertAdjacentHTML('beforeend', attachRowHtml(att));
    }

    function collectAttachments() {
        var result = [];
        document.querySelectorAll('#attach-rows .attach-row').forEach(function (row) {
            var type = row.querySelector('.a-type').value;
            var path = row.querySelector('.a-path').value.trim();
            var optional = row.querySelector('.a-optional').checked;
            var credId = row.querySelector('.a-cred').value;
            if (!path) return;
            if (type === 'file') {
                result.push({ type: 'file', path: path, optional: optional });
            } else {
                var item = { type: 'http', url: path, optional: optional };
                if (credId) item.credentialId = credId;
                result.push(item);
            }
        });
        return result;
    }

    function fillMailParams(params) {
        document.getElementById('m-to').value = (params.to || []).join(', ');
        document.getElementById('m-cc').value = (params.cc || []).join(', ');
        document.getElementById('m-subject').value = params.subject || '';
        document.getElementById('m-body').value = params.body || '';
        document.getElementById('m-html').checked = params.bodyIsHtml === true;
        document.getElementById('attach-rows').innerHTML = '';
        (params.attachments || []).forEach(function (a) { addAttachRow(a); });
    }

    function collectMailParams() {
        var splitAddresses = function (text) {
            return text.split(/[,;，；]/).map(function (s) { return s.trim(); }).filter(function (s) { return s.length > 0; });
        };
        return {
            to: splitAddresses(document.getElementById('m-to').value),
            cc: splitAddresses(document.getElementById('m-cc').value),
            subject: document.getElementById('m-subject').value,
            body: document.getElementById('m-body').value,
            bodyIsHtml: document.getElementById('m-html').checked,
            attachments: collectAttachments()
        };
    }

    function addHeaderRow(key, value) {
        var row = document.createElement('div');
        row.style.cssText = 'display:flex; gap:8px; margin-bottom:6px; max-width: 640px;';
        row.innerHTML =
            '<input class="h-key" type="text" placeholder="Header 名" style="flex:1; padding:7px 9px; border:1px solid #dcdde1; border-radius:4px;" value="' + escapeHtml(key) + '" />' +
            '<input class="h-value" type="text" placeholder="值" style="flex:2; padding:7px 9px; border:1px solid #dcdde1; border-radius:4px;" value="' + escapeHtml(value) + '" />' +
            '<button type="button" class="btn mini danger" onclick="this.parentNode.remove()">删</button>';
        document.getElementById('header-rows').appendChild(row);
    }

    function fillHttpParams(params) {
        document.getElementById('p-method').value = (params.method || 'GET').toUpperCase();
        document.getElementById('p-url').value = params.url || '';
        document.getElementById('p-body').value = params.body || '';
        document.getElementById('p-success').value = params.successContains || '';
        document.getElementById('p-auth').value = params.auth ? JSON.stringify(params.auth, null, 2) : '';
        document.getElementById('header-rows').innerHTML = '';
        var headers = params.headers || {};
        var keys = Object.keys(headers);
        if (keys.length === 0) addHeaderRow('', '');
        keys.forEach(function (k) { addHeaderRow(k, headers[k]); });
    }

    function buildHttpParams() {
        var headers = {};
        document.querySelectorAll('#header-rows .h-key').forEach(function (input, i) {
            var key = input.value.trim();
            var value = document.querySelectorAll('#header-rows .h-value')[i].value;
            if (key) headers[key] = value;
        });
        var params = {
            method: document.getElementById('p-method').value,
            url: document.getElementById('p-url').value.trim(),
            headers: headers,
            body: document.getElementById('p-body').value,
            successContains: document.getElementById('p-success').value
        };
        var authText = document.getElementById('p-auth').value.trim();
        if (authText) {
            try {
                params.auth = JSON.parse(authText);
            } catch (e) {
                return { error: 'auth 块不是合法 JSON：' + e.message };
            }
        }
        return params;
    }

    function buildCron() {
        if (currentMode() === 'once') {
            var v = document.getElementById('f-once').value;
            if (!v) return null;
            return 'once:' + v.replace('T', ' ');
        }
        var expr = document.getElementById('f-cron').value.trim();
        return expr || null;
    }

    async function loadTask() {
        loadCredentialOptions();
        if (!taskId) { fillHttpParams({}); addAttachRow({ type: 'file', optional: false }); fillNotifyPolicy(null); return; }
        document.getElementById('page-title').textContent = '编辑任务 #' + taskId;
        var resp = await fetchApi('/api/tasks/' + taskId);
        if (!resp.ok) { showFormError('任务加载失败：' + resp.status); return; }
        var t = await resp.json();
        document.getElementById('f-name').value = t.name;
        document.getElementById('f-group').value = t.groupName || 'default';
        document.getElementById('f-remark').value = t.remark || '';
        document.getElementById('f-timeout').value = t.timeoutSec;
        document.getElementById('f-retry').value = t.retryMax;
        document.getElementById('f-enabled').value = String(t.enabled);
        document.getElementById('f-type').value = t.taskType;
        onTypeChange();
        fillNotifyPolicy(t.notifyPolicy);

        if (t.cron && t.cron.toLowerCase().indexOf('once:') === 0) {
            document.querySelector('input[name="trigger-mode"][value="once"]').checked = true;
            document.getElementById('f-once').value = t.cron.slice(5).trim().replace(' ', 'T');
        } else {
            document.querySelector('input[name="trigger-mode"][value="cron"]').checked = true;
            document.getElementById('f-cron').value = t.cron;
        }
        onModeChange();

        var params = {};
        try { params = JSON.parse(t.params || '{}') || {}; } catch (e) { }
        if (t.taskType === 'mail') {
            fillMailParams(params);
        } else {
            fillHttpParams(params);
        }
        schedulePreview();
    }

    async function save(e) {
        e.preventDefault();
        hideFormError();
        var taskType = document.getElementById('f-type').value;
        var name = document.getElementById('f-name').value.trim();
        if (!name) { showFormError('任务名称不能为空'); return false; }
        var cron = buildCron();
        if (!cron) { showFormError(currentMode() === 'once' ? '请选择 once 触发时间' : 'cron 表达式不能为空'); return false; }

        var params;
        if (taskType === 'mail') {
            params = collectMailParams();
            if (params.to.length === 0) { showFormError('mail 参数缺少收件人 to'); return false; }
        } else {
            params = buildHttpParams();
            if (params && params.error) { showFormError(params.error); return false; }
            if (params && !params.url) { showFormError('http 参数缺少 url'); return false; }
        }

        var payload = {
            name: name,
            groupName: document.getElementById('f-group').value.trim() || 'default',
            taskType: taskType,
            cron: cron,
            params: JSON.stringify(params || {}),
            timeoutSec: parseInt(document.getElementById('f-timeout').value) || 30,
            retryMax: parseInt(document.getElementById('f-retry').value),
            enabled: document.getElementById('f-enabled').value === '1',
            remark: document.getElementById('f-remark').value.trim(),
            notifyPolicy: buildNotifyPolicy()
        };

        var saveBtn = document.getElementById('save-btn');
        saveBtn.disabled = true;
        try {
            var resp = await fetchApi(taskId ? '/api/tasks/' + taskId : '/api/tasks', {
                method: taskId ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (resp.ok) { location.href = '/tasks'; return false; }
            var d = await resp.json().catch(function () { return {}; });
            showFormError(d.message || ('保存失败：' + resp.status));
        } catch (err) {
            if (err && err.message !== 'unauthorized') showFormError('网络错误，保存失败');
        } finally {
            saveBtn.disabled = false;
        }
        return false;
    }

    loadTask();
</script>
}
