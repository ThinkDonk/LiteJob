@page
@model LiteJob.Web.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "登录 - LiteJob";
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: "Segoe UI", "Microsoft YaHei", sans-serif; font-size: 14px; background: #f5f6fa; }
        .login-box { width: 340px; margin: 18vh auto 0; background: #fff; border: 1px solid #e1e4e8; border-radius: 8px; padding: 32px; }
        .login-box h1 { font-size: 22px; text-align: center; margin-bottom: 24px; color: #2f3542; }
        .login-box label { display: block; margin: 12px 0 6px; color: #57606f; }
        .login-box input { width: 100%; padding: 9px 10px; border: 1px solid #dcdde1; border-radius: 4px; font-size: 14px; }
        .login-box input:focus { outline: none; border-color: #4b7bec; }
        .login-box button { width: 100%; margin-top: 20px; padding: 10px; background: #4b7bec; color: #fff; border: none; border-radius: 4px; font-size: 15px; cursor: pointer; }
        .login-box button:hover { background: #3867d6; }
        .login-box button:disabled { background: #a5b1c2; cursor: not-allowed; }
        #error { display: none; margin-top: 14px; padding: 8px 10px; background: #fdecea; color: #c0392b; border: 1px solid #f5b7b1; border-radius: 4px; text-align: center; }
    </style>
</head>
<body>
    <div class="login-box">
        <h1>LiteJob 登录</h1>
        <form id="login-form" method="post" onsubmit="return doLogin(event);">
            <label for="username">用户名</label>
            <input id="username" name="username" type="text" autocomplete="username" required />
            <label for="password">密码</label>
            <input id="password" name="password" type="password" autocomplete="current-password" required />
            <button id="submit-btn" type="submit">登 录</button>
            <div id="error"></div>
        </form>
    </div>
    <script>
        async function doLogin(e) {
            e.preventDefault();
            var error = document.getElementById('error');
            var btn = document.getElementById('submit-btn');
            error.style.display = 'none';
            btn.disabled = true;
            try {
                var resp = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        username: document.getElementById('username').value,
                        password: document.getElementById('password').value
                    })
                });
                var data = await resp.json().catch(function () { return {}; });
                if (resp.ok) {
                    location.href = '/';
                    return false;
                }
                error.textContent = data.message || '登录失败';
                error.style.display = 'block';
            } catch (err) {
                error.textContent = '网络错误，请重试';
                error.style.display = 'block';
            } finally {
                btn.disabled = false;
            }
            return false;
        }
    </script>
</body>
</html>
