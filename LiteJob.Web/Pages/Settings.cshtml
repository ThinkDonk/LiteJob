@page
@model LiteJob.Web.Pages.SettingsModel
@{
    ViewData["Title"] = "系统设置 - LiteJob";
    Layout = "_Layout";
}

<h2 class="page-title">系统设置</h2>

<div id="global-error"></div>
<div id="save-tip" style="display:none; margin-bottom: 12px; padding: 8px 12px; background: #e8f8ef; color: #1e8e5a; border: 1px solid #b7e4cd; border-radius: 4px;"></div>

<div class="panel">
    <div class="section-title" style="margin-top: 0;">SMTP 邮件发送</div>
    <div style="display:flex; gap: 24px; flex-wrap: wrap;">
        <div class="form-item" style="flex:2; min-width: 220px;">
            <label>SMTP 服务器</label>
            <input id="s-host" type="text" placeholder="如 smtp.example.com" />
        </div>
        <div class="form-item" style="flex:1; min-width: 120px;">
            <label>端口</label>
            <input id="s-port" type="number" placeholder="25" />
        </div>
        <div class="form-item" style="flex:1; min-width: 120px;">
            <label>SSL</label>
            <select id="s-ssl"><option value="0">否（STARTTLS 可用时升级）</option><option value="1">是（连接即 TLS）</option></select>
        </div>
    </div>
    <div style="display:flex; gap: 24px; flex-wrap: wrap;">
        <div class="form-item" style="flex:1; min-width: 160px;">
            <label>用户名</label>
            <input id="s-user" type="text" />
        </div>
        <div class="form-item" style="flex:1; min-width: 160px;">
            <label>密码（保存后加密存储，留空保持不变）</label>
            <input id="s-pass" type="password" placeholder="@("*** 或留空保持不变")" />
        </div>
    </div>
    <div style="display:flex; gap: 24px; flex-wrap: wrap;">
        <div class="form-item" style="flex:2; min-width: 220px;">
            <label>发件人地址</label>
            <input id="s-from" type="text" placeholder="noreply@example.com" />
        </div>
        <div class="form-item" style="flex:1; min-width: 160px;">
            <label>发件人名称</label>
            <input id="s-from-name" type="text" placeholder="LiteJob 调度中心" />
        </div>
    </div>
    <div style="display:flex; gap: 12px; align-items:center;">
        <button type="button" class="btn primary" onclick="save()">保存设置</button>
        <button type="button" class="btn" onclick="smtpTest()">测试连接</button>
        <span id="test-result"></span>
    </div>
</div>

<div class="panel">
    <div class="section-title" style="margin-top: 0;">维护策略（M6 维护循环实装）</div>
    <div style="display:flex; gap: 24px; flex-wrap: wrap;">
        <div class="form-item" style="flex:1; min-width: 200px;">
            <label>执行记录保留天数</label>
            <input id="m-retention" type="number" min="1" max="365" />
        </div>
        <div class="form-item" style="flex:1; min-width: 200px;">
            <label>数据库备份保留份数</label>
            <input id="m-backup" type="number" min="1" max="60" />
        </div>
    </div>
    <button type="button" class="btn primary" onclick="save()">保存设置</button>
</div>

@section Scripts {
<script>
    function escapeHtml(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function tip(msg) {
        var box = document.getElementById('save-tip');
        box.textContent = msg;
        box.style.display = 'block';
        setTimeout(function () { box.style.display = 'none'; }, 4000);
    }

    async function load() {
        try {
            var resp = await fetchApi('/api/configs');
            if (!resp.ok) { showError('加载配置失败：' + resp.status); return; }
            var d = await resp.json();
            var v = d.values || {};
            document.getElementById('s-host').value = v['smtp.host'] || '';
            document.getElementById('s-port').value = v['smtp.port'] || '';
            document.getElementById('s-ssl').value = v['smtp.ssl'] || '0';
            document.getElementById('s-user').value = v['smtp.user'] || '';
            document.getElementById('s-pass').value = '';
            document.getElementById('s-pass').placeholder = v['smtp.pass'] ? '***（已设置，留空保持不变）' : '未设置';
            document.getElementById('s-from').value = v['smtp.from'] || '';
            document.getElementById('s-from-name').value = v['smtp.from_name'] || '';
            document.getElementById('m-retention').value = v['maintenance.run_retention_days'] || '30';
            document.getElementById('m-backup').value = v['maintenance.backup_keep'] || '7';
        } catch (err) {
            if (err && err.message !== 'unauthorized') showError('网络错误');
        }
    }

    function collect() {
        var values = {
            'smtp.host': document.getElementById('s-host').value.trim(),
            'smtp.port': document.getElementById('s-port').value.trim(),
            'smtp.ssl': document.getElementById('s-ssl').value,
            'smtp.user': document.getElementById('s-user').value.trim(),
            'smtp.from': document.getElementById('s-from').value.trim(),
            'smtp.from_name': document.getElementById('s-from-name').value.trim(),
            'maintenance.run_retention_days': document.getElementById('m-retention').value.trim(),
            'maintenance.backup_keep': document.getElementById('m-backup').value.trim()
        };
        var pass = document.getElementById('s-pass').value;
        if (pass.length > 0) values['smtp.pass'] = pass;
        return values;
    }

    async function save() {
        var resp = await fetchApi('/api/configs', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ values: collect() })
        });
        if (resp.status === 403) { alert('无权限：仅管理员可修改设置'); return; }
        if (!resp.ok) { var d = await resp.json().catch(function () { return {}; }); alert(d.message || '保存失败'); return; }
        tip('设置已保存');
        load();
    }

    async function smtpTest() {
        var box = document.getElementById('test-result');
        box.textContent = '测试中…';
        box.className = 'muted';
        var resp = await fetchApi('/api/configs/smtp-test', { method: 'POST' });
        var d = await resp.json();
        if (d.ok) {
            box.textContent = '✓ 连接成功（含认证）';
            box.style.color = '#1e8e5a';
        } else {
            box.textContent = '✗ ' + (d.error || '连接失败');
            box.style.color = '#c0392b';
        }
    }

    function showError(msg) {
        var box = document.getElementById('global-error');
        box.textContent = msg; box.style.display = 'block';
    }

    load();
</script>
}
