@page
@model LiteJob.Web.Pages.CredentialsModel
@{
    ViewData["Title"] = "凭证管理 - LiteJob";
    Layout = "_Layout";
}

<h2 class="page-title">凭证管理</h2>

<div id="global-error"></div>
<div id="action-tip" style="display:none; margin-bottom: 12px; padding: 8px 12px; background: #e8f8ef; color: #1e8e5a; border: 1px solid #b7e4cd; border-radius: 4px;"></div>

<div class="toolbar">
    <span class="muted">凭证值加密存储（AES-256-GCM），任何接口不回显明文。</span>
    <span style="flex:1"></span>
    <button class="btn primary" onclick="openEditor(null)">＋ 新建凭证</button>
</div>

<div class="panel" style="padding: 0;">
    <table class="grid" id="cred-table">
        <thead>
            <tr><th>名称</th><th>备注</th><th>值</th><th>更新时间</th><th style="min-width: 240px;">操作</th></tr>
        </thead>
        <tbody><tr><td colspan="5" class="muted">加载中…</td></tr></tbody>
    </table>
</div>

<div class="panel" id="editor-panel" style="display:none;">
    <div class="section-title" style="margin-top: 0;" id="editor-title">新建凭证</div>
    <div class="form-item">
        <label>名称 *（任务参数中以 $cred:名称.key 引用）</label>
        <input id="e-name" type="text" placeholder="如 wms-report" />
    </div>
    <div class="form-item">
        <label>备注</label>
        <input id="e-remark" type="text" placeholder="选填" />
    </div>
    <div class="form-item">
        <label>键值对（值可多行；保存时拼为 JSON 对象整体加密）</label>
        <div id="kv-rows"></div>
        <button type="button" class="btn mini" onclick="addKvRow('', '')">＋ 添加键值</button>
        <div class="muted" style="margin-top: 6px; font-size: 12px;">示例：key = API Key 值；user / pass = 登录账号。http 附件的 credentialId 引用取 key/token/apikey 字段。</div>
    </div>
    <div style="display:flex; gap: 12px;">
        <button type="button" class="btn primary" id="save-btn" onclick="saveCred()">保 存</button>
        <button type="button" class="btn" onclick="closeEditor()">取消</button>
        <span class="muted" id="e-status" style="align-self:center;"></span>
    </div>
</div>

@section Scripts {
<script>
    var editingId = null;

    function escapeHtml(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function tip(msg) {
        var box = document.getElementById('action-tip');
        box.textContent = msg;
        box.style.display = 'block';
        setTimeout(function () { box.style.display = 'none'; }, 4000);
    }

    function showError(msg) {
        var box = document.getElementById('global-error');
        box.textContent = msg; box.style.display = 'block';
    }

    function addKvRow(key, value) {
        var row = document.createElement('div');
        row.style.cssText = 'display:flex; gap:8px; margin-bottom:6px; max-width: 640px;';
        row.innerHTML =
            '<input class="kv-key" type="text" placeholder="键（如 key/user/pass）" style="flex:1; padding:7px 9px; border:1px solid #dcdde1; border-radius:4px;" value="' + escapeHtml(key) + '" />' +
            '<textarea class="kv-value" rows="1" placeholder="值（可多行）" style="flex:2; padding:7px 9px; border:1px solid #dcdde1; border-radius:4px; font-family:inherit;">' + escapeHtml(value) + '</textarea>' +
            '<button type="button" class="btn mini danger" onclick="this.parentNode.remove()">删</button>';
        document.getElementById('kv-rows').appendChild(row);
    }

    async function reload() {
        try {
            var resp = await fetchApi('/api/credentials');
            if (!resp.ok) { showError('加载凭证列表失败：' + resp.status); return; }
            var data = await resp.json();
            var tbody = document.querySelector('#cred-table tbody');
            if (data.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="muted">暂无凭证</td></tr>';
                return;
            }
            tbody.innerHTML = data.items.map(function (c) {
                return '<tr><td>' + escapeHtml(c.name) + '</td><td>' + escapeHtml(c.remark || '-') +
                    '</td><td><span class="badge green">已加密存储</span></td><td>' + fmtTime(c.updatedAt) +
                    '</td><td>' +
                    '<button class="btn mini" onclick="verify(' + c.id + ')">verify 自检</button> ' +
                    '<button class="btn mini" onclick="openEditor(' + c.id + ')">编辑</button> ' +
                    '<button class="btn mini danger" onclick="removeCred(' + c.id + ',\'' + escapeHtml(c.name) + '\')">删除</button>' +
                    '<span class="verify-result muted" data-id="' + c.id + '" style="margin-left:8px;"></span>' +
                    '</td></tr>';
            }).join('');
        } catch (err) {
            if (err && err.message !== 'unauthorized') showError('网络错误');
        }
    }

    async function openEditor(id) {
        editingId = id;
        document.getElementById('editor-panel').style.display = '';
        document.getElementById('e-status').textContent = '';
        document.getElementById('kv-rows').innerHTML = '';
        if (id === null) {
            document.getElementById('editor-title').textContent = '新建凭证';
            document.getElementById('e-name').value = '';
            document.getElementById('e-remark').value = '';
            addKvRow('key', '');
            return;
        }
        document.getElementById('editor-title').textContent = '编辑凭证 #' + id;
        var resp = await fetchApi('/api/credentials');
        var data = await resp.json();
        var cred = data.items.filter(function (c) { return c.id === id; })[0];
        if (!cred) { showError('凭证不存在'); return; }
        document.getElementById('e-name').value = cred.name;
        document.getElementById('e-remark').value = cred.remark || '';
        addKvRow('key', '');
        tip('编辑模式：值不回显，重新填写需要更新的键值对后保存（全部覆盖）');
    }

    function closeEditor() {
        document.getElementById('editor-panel').style.display = 'none';
        editingId = null;
    }

    function collectKv() {
        var obj = {};
        var keys = document.querySelectorAll('#kv-rows .kv-key');
        var values = document.querySelectorAll('#kv-rows .kv-value');
        keys.forEach(function (input, i) {
            var key = input.value.trim();
            if (key) obj[key] = values[i].value;
        });
        return JSON.stringify(obj);
    }

    async function saveCred() {
        var name = document.getElementById('e-name').value.trim();
        if (!name) { alert('凭证名称不能为空'); return; }
        var valueJson = collectKv();
        var payload = { name: name, valueJson: valueJson, remark: document.getElementById('e-remark').value.trim() };
        var saveBtn = document.getElementById('save-btn');
        saveBtn.disabled = true;
        try {
            var resp = await fetchApi(editingId ? '/api/credentials/' + editingId : '/api/credentials', {
                method: editingId ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (resp.ok) {
                tip('已保存（值已加密存储）');
                closeEditor();
                reload();
                return;
            }
            var d = await resp.json().catch(function () { return {}; });
            document.getElementById('e-status').textContent = d.message || ('保存失败：' + resp.status);
            document.getElementById('e-status').style.color = '#c0392b';
        } finally {
            saveBtn.disabled = false;
        }
    }

    async function verify(id) {
        var resultBox = document.querySelector('.verify-result[data-id="' + id + '"]');
        try {
            var resp = await fetchApi('/api/credentials/' + id + '/verify', { method: 'POST' });
            var d = await resp.json();
            if (d.ok) {
                resultBox.textContent = '✓ 自检通过（键：' + (d.keys || []).join(', ') + '）';
                resultBox.style.color = '#1e8e5a';
            } else {
                resultBox.textContent = '✗ ' + (d.error || '自检失败');
                resultBox.style.color = '#c0392b';
            }
        } catch (err) {
            resultBox.textContent = '✗ 网络错误';
            resultBox.style.color = '#c0392b';
        }
    }

    async function removeCred(id, name) {
        if (!confirm('确认删除凭证「' + name + '」？引用它的任务将执行失败。')) return;
        var resp = await fetchApi('/api/credentials/' + id, { method: 'DELETE' });
        if (!resp.ok) { var d = await resp.json().catch(function () { return {}; }); alert(d.message || '删除失败'); return; }
        tip('已删除');
        reload();
    }

    reload();
</script>
}
