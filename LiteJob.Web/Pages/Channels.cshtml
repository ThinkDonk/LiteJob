@page
@model LiteJob.Web.Pages.ChannelsModel
@{
    ViewData["Title"] = "告警通道 - LiteJob";
    Layout = "_Layout";
}

<h2 class="page-title">告警通道</h2>

<div id="global-error"></div>
<div id="action-tip" style="display:none; margin-bottom: 12px; padding: 8px 12px; background: #e8f8ef; color: #1e8e5a; border: 1px solid #b7e4cd; border-radius: 4px;"></div>

<div class="toolbar">
    <span class="muted">通道健康：发送结果实时记录（ok 绿 / fail 红），失败也会记录。</span>
    <span style="flex:1"></span>
    <button class="btn primary" onclick="openEditor(null)">＋ 新建通道</button>
</div>

<div class="panel" style="padding: 0;">
    <table class="grid" id="channel-table">
        <thead>
            <tr><th>名称</th><th>类型</th><th>健康灯</th><th>最近发送</th><th>状态</th><th style="min-width: 220px;">操作</th></tr>
        </thead>
        <tbody><tr><td colspan="6" class="muted">加载中…</td></tr></tbody>
    </table>
</div>

<div class="panel" id="editor-panel" style="display:none;">
    <div class="section-title" style="margin-top: 0;" id="editor-title">新建通道</div>
    <div class="form-item">
        <label>名称 *</label>
        <input id="e-name" type="text" placeholder="如 企微-WMS 群" />
    </div>
    <div style="display:flex; gap: 24px; flex-wrap: wrap;">
        <div class="form-item" style="flex:1; min-width: 160px;">
            <label>类型 *</label>
            <select id="e-type" onchange="onTypeChange()">
                <option value="wecom">wecom（企业微信）</option>
                <option value="dingtalk">dingtalk（钉钉）</option>
                <option value="feishu">feishu（飞书）</option>
                <option value="custom">custom（自定义 Webhook）</option>
            </select>
        </div>
        <div class="form-item" style="flex:1; min-width: 120px;">
            <label>启用</label>
            <select id="e-enabled"><option value="1">启用</option><option value="0">停用</option></select>
        </div>
    </div>
    <div class="form-item">
        <label>Webhook URL *</label>
        <input id="e-url" type="text" placeholder="https://..." />
    </div>
    <div class="form-item" id="secret-item">
        <label>加签密钥 secret（钉钉专用；已存储时留空保持不变）</label>
        <input id="e-secret" type="password" />
    </div>
    <div class="form-item" id="mobiles-item">
        <label>at 手机号（可选，多个用逗号分隔；钉钉 atMobiles 生效）</label>
        <input id="e-mobiles" type="text" placeholder="13800000001,13800000002" />
    </div>
    <div class="form-item" id="template-item" style="display:none;">
        <label>body 模板（custom 专用，支持 {title}/{body} 占位）</label>
        <textarea id="e-template" rows="3" placeholder='{"title":"{title}","body":"{body}"}'></textarea>
    </div>
    <div style="display:flex; gap: 12px; align-items:center;">
        <button type="button" class="btn primary" id="save-btn" onclick="saveChannel()">保 存</button>
        <button type="button" class="btn" onclick="closeEditor()">取消</button>
        <button type="button" class="btn" id="test-btn" onclick="testChannel()">发送测试消息</button>
        <span id="test-result"></span>
    </div>
</div>

@section Scripts {
<script>
    var editingId = null;

    function escapeHtml(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function tip(msg) {
        var box = document.getElementById('action-tip');
        box.textContent = msg;
        box.style.display = 'block';
        setTimeout(function () { box.style.display = 'none'; }, 4000);
    }

    function showError(msg) {
        var box = document.getElementById('global-error');
        box.textContent = msg; box.style.display = 'block';
    }

    function healthBadge(status) {
        if (status === 'ok') return '<span class="badge green">● ok</span>';
        if (status && status.indexOf('fail:') === 0) return '<span class="badge red">● ' + escapeHtml(status) + '</span>';
        return '<span class="badge gray">● 未发送</span>';
    }

    async function reload() {
        try {
            var resp = await fetchApi('/api/channels');
            if (!resp.ok) { showError('加载通道列表失败：' + resp.status); return; }
            var data = await resp.json();
            var tbody = document.querySelector('#channel-table tbody');
            if (data.items.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="muted">暂无告警通道</td></tr>';
                return;
            }
            tbody.innerHTML = data.items.map(function (c) {
                var enabled = c.enabled === 1 ? '<span class="badge blue">启用</span>' : '<span class="badge gray">停用</span>';
                return '<tr><td>' + escapeHtml(c.name) + '</td><td>' + escapeHtml(c.type) +
                    '</td><td>' + healthBadge(c.lastStatus) + '</td><td>' + fmtTime(c.lastSentAt) +
                    '</td><td>' + enabled + '</td><td>' +
                    '<button class="btn mini" onclick="testChannel(' + c.id + ')">测试发送</button> ' +
                    '<button class="btn mini" onclick="openEditor(' + c.id + ')">编辑</button> ' +
                    '<button class="btn mini danger" onclick="removeChannel(' + c.id + ',\'' + escapeHtml(c.name) + '\')">删除</button>' +
                    '</td></tr>';
            }).join('');
        } catch (err) {
            if (err && err.message !== 'unauthorized') showError('网络错误');
        }
    }

    function onTypeChange() {
        var type = document.getElementById('e-type').value;
        document.getElementById('secret-item').style.display = type === 'dingtalk' ? '' : 'none';
        document.getElementById('mobiles-item').style.display = (type === 'dingtalk' || type === 'wecom') ? '' : 'none';
        document.getElementById('template-item').style.display = type === 'custom' ? '' : 'none';
    }

    async function openEditor(id) {
        editingId = id;
        document.getElementById('editor-panel').style.display = '';
        document.getElementById('test-result').textContent = '';
        if (id === null) {
            document.getElementById('editor-title').textContent = '新建通道';
            document.getElementById('e-name').value = '';
            document.getElementById('e-type').value = 'wecom';
            document.getElementById('e-url').value = '';
            document.getElementById('e-secret').value = '';
            document.getElementById('e-mobiles').value = '';
            document.getElementById('e-template').value = '';
            document.getElementById('e-enabled').value = '1';
            onTypeChange();
            return;
        }
        document.getElementById('editor-title').textContent = '编辑通道 #' + id;
        var resp = await fetchApi('/api/channels');
        var data = await resp.json();
        var ch = data.items.filter(function (c) { return c.id === id; })[0];
        if (!ch) { showError('通道不存在'); return; }
        document.getElementById('e-name').value = ch.name;
        document.getElementById('e-type').value = ch.type;
        document.getElementById('e-url').value = ch.webhookUrl;
        document.getElementById('e-secret').value = '';
        document.getElementById('e-secret').placeholder = ch.secret ? '***（已存储，留空保持不变）' : '';
        document.getElementById('e-mobiles').value = ch.atMobiles || '';
        document.getElementById('e-template').value = ch.bodyTemplate || '';
        document.getElementById('e-enabled').value = String(ch.enabled);
        onTypeChange();
    }

    function closeEditor() {
        document.getElementById('editor-panel').style.display = 'none';
        editingId = null;
    }

    async function saveChannel() {
        var name = document.getElementById('e-name').value.trim();
        if (!name) { alert('通道名称不能为空'); return; }
        var payload = {
            name: name,
            type: document.getElementById('e-type').value,
            webhookUrl: document.getElementById('e-url').value.trim(),
            secret: document.getElementById('e-secret').value.trim(),
            atMobiles: document.getElementById('e-mobiles').value.trim(),
            bodyTemplate: document.getElementById('e-template').value,
            enabled: document.getElementById('e-enabled').value === '1'
        };
        var saveBtn = document.getElementById('save-btn');
        saveBtn.disabled = true;
        try {
            var resp = await fetchApi(editingId ? '/api/channels/' + editingId : '/api/channels', {
                method: editingId ? 'PUT' : 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (resp.ok) { tip('已保存'); closeEditor(); reload(); return; }
            var d = await resp.json().catch(function () { return {}; });
            alert(d.message || '保存失败');
        } finally {
            saveBtn.disabled = false;
        }
    }

    async function testChannel(id) {
        var target = id || editingId;
        if (!target) { alert('请先保存通道'); return; }
        var box = document.getElementById('test-result');
        box.textContent = '发送中…';
        box.className = 'muted';
        try {
            var resp = await fetchApi('/api/channels/' + target + '/test', { method: 'POST' });
            var d = await resp.json();
            if (d.ok) { box.textContent = '✓ 测试消息已发送'; box.style.color = '#1e8e5a'; }
            else { box.textContent = '✗ ' + (d.error || '发送失败'); box.style.color = '#c0392b'; }
        } catch (err) { box.textContent = '✗ 网络错误'; box.style.color = '#c0392b'; }
        reload();
    }

    async function removeChannel(id, name) {
        if (!confirm('确认删除通道「' + name + '」？')) return;
        var resp = await fetchApi('/api/channels/' + id, { method: 'DELETE' });
        if (!resp.ok) { var d = await resp.json().catch(function () { return {}; }); alert(d.message || '删除失败'); return; }
        tip('已删除');
        reload();
    }

    reload();
</script>
}
