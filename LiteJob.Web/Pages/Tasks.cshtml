@page
@model LiteJob.Web.Pages.TasksModel
@{
    ViewData["Title"] = "任务列表 - LiteJob";
    Layout = "_Layout";
}

<h2 class="page-title">任务列表</h2>

<div id="global-error"></div>
<div id="action-tip" style="display:none; margin-bottom: 12px; padding: 8px 12px; background: #e8f8ef; color: #1e8e5a; border: 1px solid #b7e4cd; border-radius: 4px;"></div>

<div class="toolbar">
    <label>关键词</label>
    <input id="f-keyword" type="text" placeholder="名称/备注" style="width: 160px;" />
    <label>分组</label>
    <input id="f-group" type="text" placeholder="分组名" style="width: 110px;" />
    <label>启用状态</label>
    <select id="f-enabled">
        <option value="">全部</option>
        <option value="1">启用</option>
        <option value="0">停用</option>
    </select>
    <button class="btn primary" onclick="reload(1)">查询</button>
    <span style="flex:1"></span>
    <input type="file" id="import-file" accept=".json" style="display:none;" onchange="importTasks(this.files[0])" />
    <button class="btn" onclick="document.getElementById('import-file').click()">导入</button>
    <button class="btn" onclick="location.href='/api/tasks/export'">导出</button>
    <a class="btn primary" href="/tasks/edit">＋ 新建任务</a>
</div>

<div class="panel" style="padding: 0;">
    <table class="grid" id="task-table">
        <thead>
            <tr>
                <th>名称</th><th>类型</th><th>cron</th><th>状态</th><th>上次结果</th>
                <th>下次触发</th><th>运行中</th><th style="min-width: 260px;">操作</th>
            </tr>
        </thead>
        <tbody><tr><td colspan="8" class="muted">加载中…</td></tr></tbody>
    </table>
</div>

<div class="pagination">
    <button class="btn mini" id="page-prev" onclick="reload(page - 1)">上一页</button>
    <span id="page-info">-</span>
    <button class="btn mini" id="page-next" onclick="reload(page + 1)">下一页</button>
</div>

@section Scripts {
<script>
    var page = 1, totalPages = 1;
    var pageSize = 15;

    function escapeHtml(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function tip(msg) {
        var box = document.getElementById('action-tip');
        box.textContent = msg;
        box.style.display = 'block';
        setTimeout(function () { box.style.display = 'none'; }, 3000);
    }

    function showError(msg) {
        var box = document.getElementById('global-error');
        box.textContent = msg; box.style.display = 'block';
    }

    function lastRunBadge(v) {
        if (v === 1) return '<span class="badge green">✓ 成功</span>';
        if (v === 0) return '<span class="badge red">✗ 失败</span>';
        return '<span class="muted">-</span>';
    }

    async function importTasks(file) {
        if (!file) return;
        try {
            var text = await file.text();
            var items = JSON.parse(text);
            if (!Array.isArray(items)) { alert('导入文件应为 JSON 数组'); return; }
            var resp = await fetchApi('/api/tasks/import', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(items)
            });
            if (resp.status === 403) { alert('无权限：仅管理员可导入'); return; }
            if (!resp.ok) { var d0 = await resp.json().catch(function () { return {}; }); alert(d0.message || '导入失败'); return; }
            var d = await resp.json();
            var skipped = (d.skipped || []).map(function (s) { return s.name + '：' + s.reason; }).join('\n');
            alert('导入完成：成功 ' + (d.imported || []).length + ' 条' + (skipped ? '\n跳过：\n' + skipped : ''));
            reload(1);
        } catch (err) {
            alert('导入失败：' + err.message);
        }
    }

    async function reload(targetPage) {
        page = Math.max(1, targetPage || 1);
        var params = new URLSearchParams({
            page: page, pageSize: pageSize,
            keyword: document.getElementById('f-keyword').value.trim(),
            group: document.getElementById('f-group').value.trim(),
            enabled: document.getElementById('f-enabled').value
        });
        try {
            var resp = await fetchApi('/api/tasks?' + params.toString());
            if (!resp.ok) { showError('加载任务列表失败：' + resp.status); return; }
            var data = await resp.json();
            totalPages = Math.max(1, Math.ceil(data.total / pageSize));
            page = Math.min(page, totalPages);
            document.getElementById('page-info').textContent = '第 ' + page + ' / ' + totalPages + ' 页，共 ' + data.total + ' 条';
            document.getElementById('page-prev').disabled = page <= 1;
            document.getElementById('page-next').disabled = page >= totalPages;

            var tbody = document.querySelector('#task-table tbody');
            if (data.total === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="muted">暂无任务，点击右上角"新建任务"创建</td></tr>';
                return;
            }
            tbody.innerHTML = data.items.map(function (t) {
                var statusBadge = t.enabled === 1 ? '<span class="badge green">启用</span>' : '<span class="badge gray">停用</span>';
                var running = t.isRunning ? '<span class="badge orange">● 运行中</span>' : '<span class="muted">-</span>';
                var next = t.nextTriggerAt ? fmtTime(t.nextTriggerAt) : '<span class="muted">-</span>';
                var actions =
                    '<button class="btn mini" onclick="toggleEnabled(' + t.id + ',' + t.enabled + ')">' + (t.enabled === 1 ? '停用' : '启用') + '</button> ' +
                    '<button class="btn mini" onclick="runNow(' + t.id + ')">立即执行</button> ' +
                    '<button class="btn mini" onclick="copyTask(' + t.id + ')">复制</button> ' +
                    '<a class="btn mini" href="/tasks/edit?id=' + t.id + '">编辑</a> ' +
                    '<button class="btn mini danger" onclick="removeTask(' + t.id + ',\'' + escapeHtml(t.name).replace(/'/g, "\\'") + '\')">删除</button>';
                var nameCell = escapeHtml(t.name) + (t.remark ? '<div class="muted" style="font-size:12px;">' + escapeHtml(t.remark) + '</div>' : '');
                var cronCell = escapeHtml(t.cron);
                return '<tr><td>' + nameCell + '</td><td>' + escapeHtml(t.taskType) + '</td><td>' + cronCell +
                    '</td><td>' + statusBadge + '</td><td>' + lastRunBadge(t.lastRunSuccess) +
                    '</td><td>' + next + '</td><td>' + running + '</td><td>' + actions + '</td></tr>';
            }).join('');
        } catch (err) {
            if (err && err.message !== 'unauthorized') showError('网络错误');
        }
    }

    function handleForbidden(resp) {
        if (resp.status === 403) { alert('无权限：该操作仅管理员可执行'); return true; }
        return false;
    }

    async function toggleEnabled(id, enabled) {
        var action = enabled === 1 ? 'disable' : 'enable';
        var resp = await fetchApi('/api/tasks/' + id + '/' + action, { method: 'POST' });
        if (handleForbidden(resp)) return;
        if (!resp.ok) { var d = await resp.json().catch(function () { return {}; }); alert(d.message || '操作失败'); return; }
        tip(enabled === 1 ? '已停用' : '已启用');
        reload(page);
    }

    async function runNow(id) {
        var resp = await fetchApi('/api/tasks/' + id + '/run', { method: 'POST' });
        if (handleForbidden(resp)) return;
        if (resp.status === 202) { tip('已提交执行（202）'); return; }
        var d = await resp.json().catch(function () { return {}; });
        alert(d.message || '提交失败');
    }

    async function copyTask(id) {
        var resp = await fetchApi('/api/tasks/' + id + '/copy', { method: 'POST' });
        if (handleForbidden(resp)) return;
        if (!resp.ok) { var d = await resp.json().catch(function () { return {}; }); alert(d.message || '复制失败'); return; }
        var c = await resp.json();
        tip('已复制为新任务：' + c.name + '（默认停用）');
        reload(1);
    }

    async function removeTask(id, name) {
        if (!confirm('确认删除任务「' + name + '」？执行历史将保留。')) return;
        var resp = await fetchApi('/api/tasks/' + id, { method: 'DELETE' });
        if (handleForbidden(resp)) return;
        if (!resp.ok) { var d = await resp.json().catch(function () { return {}; }); alert(d.message || '删除失败'); return; }
        tip('已删除');
        reload(page);
    }

    document.getElementById('f-keyword').addEventListener('keyup', function (e) { if (e.key === 'Enter') reload(1); });
    reload(1);
</script>
}
