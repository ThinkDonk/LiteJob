@page
@model LiteJob.Web.Pages.IndexModel
@{
    ViewData["Title"] = "仪表盘 - LiteJob";
    Layout = "_Layout";
}

<h2 class="page-title">仪表盘</h2>

<div id="global-error"></div>

<div class="cards" style="margin-bottom: 16px;">
    <div class="card"><div class="label">任务总数</div><div class="value" id="stat-total">--</div></div>
    <div class="card"><div class="label">启用任务</div><div class="value" id="stat-enabled">--</div></div>
    <div class="card"><div class="label">今日执行</div><div class="value" id="stat-today-runs">--</div></div>
    <div class="card"><div class="label">今日成功率</div><div class="value" id="stat-success-rate">--</div></div>
</div>

<div class="panel">
    <div class="section-title" style="margin-top: 0;">调度内核</div>
    <div style="display: flex; gap: 40px; flex-wrap: wrap;">
        <div><span class="muted">存活时长：</span><span id="kernel-alive">--</span></div>
        <div><span class="muted">堆内任务：</span><span id="kernel-heap">--</span></div>
        <div><span class="muted">最近异常：</span><span id="kernel-error">--</span></div>
    </div>
</div>

<div class="panel">
    <div class="section-title" style="margin-top: 0;">最近失败（5 条）</div>
    <table class="grid" id="failure-table">
        <thead>
            <tr><th>任务名</th><th>结束时间</th><th>错误摘要</th></tr>
        </thead>
        <tbody><tr><td colspan="3" class="muted">加载中…</td></tr></tbody>
    </table>
</div>

@section Scripts {
<script>
    var lastLoopStartedAt = null;

    function fmtAlive(ms) {
        if (ms < 0) ms = 0;
        var s = Math.floor(ms / 1000);
        var days = Math.floor(s / 86400);
        var hh = pad(Math.floor(s % 86400 / 3600));
        var mm = pad(Math.floor(s % 3600 / 60));
        var ss = pad(s % 60);
        return days > 0 ? days + '天 ' + hh + ':' + mm + ':' + ss : hh + ':' + mm + ':' + ss;
    }

    function showError(msg) {
        var box = document.getElementById('global-error');
        box.textContent = msg;
        box.style.display = 'block';
    }

    async function loadDashboard() {
        try {
            var resp = await fetchApi('/api/dashboard');
            if (!resp.ok) { showError('加载仪表盘失败：' + resp.status); return; }
            var d = await resp.json();
            document.getElementById('global-error').style.display = 'none';

            document.getElementById('stat-total').textContent = d.taskTotal;
            document.getElementById('stat-enabled').textContent = d.taskEnabled;
            document.getElementById('stat-today-runs').textContent = d.todayRuns;
            document.getElementById('stat-success-rate').textContent =
                d.todaySuccessRate === null ? '-' : d.todaySuccessRate + '%';

            var h = d.schedulerHealth;
            document.getElementById('kernel-heap').textContent = h.heapSize;
            var errorBox = document.getElementById('kernel-error');
            if (h.lastError) {
                errorBox.textContent = h.lastError + (h.lastErrorAt ? '（' + fmtTime(h.lastErrorAt) + '）' : '');
                errorBox.style.color = '#c0392b';
            } else {
                errorBox.textContent = '无';
                errorBox.style.color = '';
            }
            lastLoopStartedAt = h.loopStartedAt;
            tickAlive();

            var tbody = document.querySelector('#failure-table tbody');
            if (!d.recentFailures || d.recentFailures.length === 0) {
                tbody.innerHTML = '<tr><td colspan="3" class="muted">暂无失败记录</td></tr>';
            } else {
                tbody.innerHTML = d.recentFailures.map(function (f) {
                    return '<tr><td>' + escapeHtml(f.taskName) + '</td><td>' + fmtTime(f.finishedAt) +
                        '</td><td style="color:#c0392b;">' + escapeHtml(f.error || '-') + '</td></tr>';
                }).join('');
            }
        } catch (err) {
            if (err && err.message !== 'unauthorized') showError('网络错误');
        }
    }

    function tickAlive() {
        var el = document.getElementById('kernel-alive');
        if (!lastLoopStartedAt) { el.textContent = '--'; return; }
        el.textContent = fmtAlive(Date.now() - new Date(lastLoopStartedAt).getTime());
    }

    function escapeHtml(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    loadDashboard();
    setInterval(loadDashboard, 30000);
    setInterval(tickAlive, 1000);
</script>
}
