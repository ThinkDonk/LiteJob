@page
@model LiteJob.Web.Pages.UsersModel
@{
    ViewData["Title"] = "用户管理 - LiteJob";
    Layout = "_Layout";
}

<h2 class="page-title">用户管理</h2>

<div id="global-error"></div>
<div id="action-tip" style="display:none; margin-bottom: 12px; padding: 8px 12px; background: #e8f8ef; color: #1e8e5a; border: 1px solid #b7e4cd; border-radius: 4px;"></div>

<div class="toolbar">
    <span class="muted">admin 角色拥有全部管理权限；viewer 只读（写操作 403）。</span>
    <span style="flex:1"></span>
    <button class="btn primary" onclick="openEditor(null)">＋ 新建用户</button>
</div>

<div class="panel" style="padding: 0;">
    <table class="grid" id="user-table">
        <thead>
            <tr><th>用户名</th><th>角色</th><th>状态</th><th>创建时间</th><th style="min-width: 220px;">操作</th></tr>
        </thead>
        <tbody><tr><td colspan="5" class="muted">加载中…</td></tr></tbody>
    </table>
</div>

<div class="panel" id="editor-panel" style="display:none;">
    <div class="section-title" style="margin-top: 0;" id="editor-title">新建用户</div>
    <div class="form-item">
        <label>用户名 *（唯一，不可修改）</label>
        <input id="e-name" type="text" />
    </div>
    <div style="display:flex; gap: 24px; flex-wrap: wrap;">
        <div class="form-item" style="flex:1; min-width: 140px;">
            <label>角色</label>
            <select id="e-role"><option value="admin">admin</option><option value="viewer">viewer</option></select>
        </div>
        <div class="form-item" style="flex:1; min-width: 140px;">
            <label>启用</label>
            <select id="e-enabled"><option value="1">启用</option><option value="0">停用</option></select>
        </div>
    </div>
    <div class="form-item">
        <label id="e-pass-label">密码 *（至少 8 位）</label>
        <input id="e-pass" type="password" />
    </div>
    <div style="display:flex; gap: 12px;">
        <button type="button" class="btn primary" id="save-btn" onclick="saveUser()">保 存</button>
        <button type="button" class="btn" onclick="closeEditor()">取消</button>
    </div>
</div>

@section Scripts {
<script>
    var editingId = null;

    function escapeHtml(s) {
        return String(s === null || s === undefined ? '' : s)
            .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function tip(msg) {
        var box = document.getElementById('action-tip');
        box.textContent = msg;
        box.style.display = 'block';
        setTimeout(function () { box.style.display = 'none'; }, 4000);
    }

    function showError(msg) {
        var box = document.getElementById('global-error');
        box.textContent = msg; box.style.display = 'block';
    }

    async function reload() {
        try {
            var resp = await fetchApi('/api/users');
            if (!resp.ok) { showError('加载用户列表失败：' + resp.status); return; }
            var data = await resp.json();
            document.querySelector('#user-table tbody').innerHTML = data.items.map(function (u) {
                var role = u.role === 'admin' ? '<span class="badge blue">admin</span>' : '<span class="badge gray">viewer</span>';
                var enabled = u.enabled === 1 ? '<span class="badge green">启用</span>' : '<span class="badge gray">停用</span>';
                var isSelf = u.username === '@Model.Username';
                var actions = '<button class="btn mini" onclick="openEditor(' + u.id + ')">编辑</button> ' +
                    (isSelf
                        ? '<span class="muted" style="font-size:12px;">（当前登录）</span>'
                        : '<button class="btn mini danger" onclick="removeUser(' + u.id + ',\'' + escapeHtml(u.username) + '\')">删除</button>');
                return '<tr><td>' + escapeHtml(u.username) + '</td><td>' + role + '</td><td>' + enabled +
                    '</td><td>' + fmtTime(u.createdAt) + '</td><td>' + actions + '</td></tr>';
            }).join('');
        } catch (err) {
            if (err && err.message !== 'unauthorized') showError('网络错误');
        }
    }

    async function openEditor(id) {
        editingId = id;
        document.getElementById('editor-panel').style.display = '';
        document.getElementById('e-pass').value = '';
        if (id === null) {
            document.getElementById('editor-title').textContent = '新建用户';
            document.getElementById('e-name').value = '';
            document.getElementById('e-name').disabled = false;
            document.getElementById('e-role').value = 'viewer';
            document.getElementById('e-enabled').value = '1';
            document.getElementById('e-pass-label').textContent = '密码 *（至少 8 位）';
            return;
        }
        document.getElementById('editor-title').textContent = '编辑用户 #' + id;
        var resp = await fetchApi('/api/users');
        var data = await resp.json();
        var u = data.items.filter(function (x) { return x.id === id; })[0];
        if (!u) { showError('用户不存在'); return; }
        document.getElementById('e-name').value = u.username;
        document.getElementById('e-name').disabled = true;
        document.getElementById('e-role').value = u.role;
        document.getElementById('e-enabled').value = String(u.enabled);
        document.getElementById('e-pass-label').textContent = '新密码（留空不改）';
    }

    function closeEditor() {
        document.getElementById('editor-panel').style.display = 'none';
        editingId = null;
    }

    async function saveUser() {
        var username = document.getElementById('e-name').value.trim();
        var password = document.getElementById('e-pass').value;
        var payload = {
            role: document.getElementById('e-role').value,
            enabled: document.getElementById('e-enabled').value === '1',
            password: password.length > 0 ? password : null
        };
        var saveBtn = document.getElementById('save-btn');
        saveBtn.disabled = true;
        try {
            var resp;
            if (editingId === null) {
                if (!username) { alert('用户名不能为空'); return; }
                if (password.length < 8) { alert('密码至少 8 位'); return; }
                resp = await fetchApi('/api/users', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: username, password: password, role: payload.role })
                });
            } else {
                resp = await fetchApi('/api/users/' + editingId, {
                    method: 'PUT', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }
            if (resp.ok) { tip('已保存'); closeEditor(); reload(); return; }
            var d = await resp.json().catch(function () { return {}; });
            alert(d.message || '保存失败');
        } finally {
            saveBtn.disabled = false;
        }
    }

    async function removeUser(id, name) {
        if (!confirm('确认删除用户「' + name + '」？')) return;
        var resp = await fetchApi('/api/users/' + id, { method: 'DELETE' });
        if (!resp.ok) { var d = await resp.json().catch(function () { return {}; }); alert(d.message || '删除失败'); return; }
        tip('已删除');
        reload();
    }

    reload();
</script>
}
